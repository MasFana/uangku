{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "uangku",
	"main": "./build/_worker.js",
	"compatibility_date": "2026-11-10",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": "./build/client",
		"run_worker_first": [
			"/api/*"
		]
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "APP_DB",
			"database_name": "APP_DB",
			"database_id": "e73aa0f0-258d-400b-8bd9-e93bb39a48b3",
			"migrations_dir": "drizzle"
		}
	]
}
