{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "uangku",
	"main": "./build/_worker.js",
	"compatibility_date": "2026-11-10",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": "./build/client",
		"run_worker_first": [
			"/api/*"
		]
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "APP_DB",
			"database_name": "APP_DB",
			"database_id": "local-app-db",
			"migrations_dir": "drizzle"
		}
	],
	"r2_buckets": [
		{
			"binding": "RECEIPTS",
			"bucket_name": "uangku-receipts"
		}
	],
	"kv_namespaces": [
		{
			"binding": "CACHE",
			"id": "local-cache"
		}
	],
	"routes": [
		{
			"pattern": "akularping.my.id",
			"custom_domain": true
		}
	]
}
