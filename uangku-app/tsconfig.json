{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		"paths": {
			"$lib": ["./src/lib"],
			"$lib/*": ["./src/lib/*"]
		}
	},
	"include": [
		"src",
		"vite.config.ts",
		"drizzle.config.ts",
		"worker-configuration.d.ts"
	],
	"exclude": [
		"node_modules",
		".svelte-kit",
		"build",
		"src/service-worker.ts"
	]
}
