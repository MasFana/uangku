{
	"name": "uangku-app",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"types": "wrangler types --include-main-module false",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply APP_DB --local",
		"db:seed:local": "node --experimental-strip-types src/lib/server/db/seed.ts",
		"test": "vitest run",
		"deploy": "wrangler deploy"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "^1.8.0",
		"@cloudflare/workers-types": "^5.20261110.1",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/adapter-cloudflare": "^8.0.2",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^26.6.6",
		"drizzle-kit": "^0.31.11",
		"drizzle-orm": "^0.45.4",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.5",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^4.1.0",
		"wrangler": "^4.160.1"
	},
	"dependencies": {
		"@fontsource-variable/instrument-sans": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@lucide/svelte": "^1.72.0",
		"better-auth": "^1.7.21",
		"bits-ui": "^2.21.0",
		"clsx": "^2.1.1",
		"lucide-svelte": "^1.0.1",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^4.0.2",
		"tw-animate-css": "^1.4.0",
		"valibot": "^1.5.0"
	}
}
